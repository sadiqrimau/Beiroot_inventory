# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only (Vercel). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
BOOTSTRAP_CODE=choose-a-long-secret-code
